# ==============================================================================
# UMMO ECOMMERCE — SAFE ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# Copy this file to .env.local (which is Git-ignored) and fill in real values.
# NEVER commit real secrets, passwords, or private keys to Git.
# ==============================================================================

# --- 1. MongoDB Atlas (Server-Only) ---
MONGODB_URI="mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/ummo_ecommerce?retryWrites=true&w=majority"
MONGODB_URI_FALLBACK=""
MONGODB_DB_NAME="ummo_ecommerce"

# --- 2. Administrator Authentication & Session Signing (Server-Only) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="<REPLACE_WITH_64_PLUS_HEX_CHAR_RANDOM_SECRET>"
ADMIN_EMAIL="admin@ummo.com"
# Recommended: Run `npm run admin:recover` to persist a salted scrypt hash in MongoDB,
# OR provide an explicit scrypt$<saltHex>$<keyHex> hash via ADMIN_PASSWORD_HASH:
ADMIN_PASSWORD_HASH=""
DEMO_ADMIN_ENABLED="false"

# --- 3. Cloudinary Media Upload Signing ---
CLOUDINARY_CLOUD_NAME="wxjt7d8q"
CLOUDINARY_API_KEY="<YOUR_CLOUDINARY_API_KEY>"
CLOUDINARY_API_SECRET="<YOUR_CLOUDINARY_API_SECRET>"
VITE_CLOUDINARY_CLOUD_NAME="wxjt7d8q"

# --- 4. SSLCommerz Gateway (Server-Only Credentials, Sandbox Mode) ---
SSLCOMMERZ_MODE="sandbox"
STORE_ID="<YOUR_SSLCOMMERZ_SANDBOX_STORE_ID>"
STORE_PASSWORD="<YOUR_SSLCOMMERZ_SANDBOX_STORE_PASSWORD>"

# --- 5. Stripe Gateway (Test Mode) ---
STRIPE_MODE="test"
STRIPE_SECRET_KEY="<sk_test_YOUR_STRIPE_TEST_SECRET_KEY>"
STRIPE_WEBHOOK_SECRET="<whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET>"
# Public publishable key (safe for frontend client configuration):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<pk_test_YOUR_STRIPE_PUBLISHABLE_KEY>"
VITE_STRIPE_PUBLISHABLE_KEY="<pk_test_YOUR_STRIPE_PUBLISHABLE_KEY>"

# --- 6. Sandbox Simulation Guardrails (Must remain false in Production) ---
PAYMENT_MODE="sandbox"
ALLOW_SANDBOX_CONFIRM="false"

# --- 7. Frontend API & Firebase Client Authentication (Public Client Config) ---
VITE_API_BASE_URL="/api/v1"
VITE_FIREBASE_API_KEY="<YOUR_FIREBASE_WEB_API_KEY>"
VITE_FIREBASE_AUTH_DOMAIN="ummo-eccomerce.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ummo-eccomerce"
VITE_FIREBASE_STORAGE_BUCKET="ummo-eccomerce.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="<YOUR_FIREBASE_SENDER_ID>"
VITE_FIREBASE_APP_ID="<YOUR_FIREBASE_WEB_APP_ID>"
VITE_FIREBASE_MEASUREMENT_ID="<YOUR_GA_MEASUREMENT_ID>"

# Public read-only administrator (server-only; disabled unless explicitly enabled)
DEMO_ADMIN_ENABLED="false"
DEMO_ADMIN_EMAIL="demo.admin@ummo.com"
DEMO_ADMIN_PASSWORD_HASH=""
# Optional public credential to show on /admin; displayed only if it matches the hash.
# Never use an owner password here. Keep its value out of Git.
DEMO_ADMIN_PUBLIC_PASSWORD=""
