# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Supabase / Neon / AWS RDS / Local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ummo_ecommerce?schema=public"

# Redis Cache & Rate Limiter (Upstash / Local Redis)
REDIS_URL="redis://localhost:6379"

# Enterprise JWT Secrets (Generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET="replace_with_64_byte_cryptographic_access_secret"
JWT_REFRESH_SECRET="replace_with_64_byte_cryptographic_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateways (Stripe & SSLCommerz)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_store_password"
SSLCOMMERZ_IS_LIVE=false
