{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://ummo-eccomerce.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/(.*)",
      "destination": "https://ummo-eccomerce.firebaseapp.com/__/firebase/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js?__seo=sitemap"
    },
    {
      "source": "/shop/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|Pinterest).*"
        }
      ],
      "destination": "/api/index.js?__seo=product&id=:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
